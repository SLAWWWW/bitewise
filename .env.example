# Lumbung — example environment. Copy to .env.local and adjust.
# Every variable is validated by src/config/env.ts (zod). Never commit real secrets.

# ── Runtime mode ─────────────────────────────────────────────────────────────
# DEMO  synthetic tenant, simulated clock, mock messaging/routing/LLM, demo controls.
# TEST  isolated fixtures and deterministic clocks (automated tests).
# LIVE  approved policies + real adapters; refuses dev secrets, owner/admin DB URLs
#       in the web process, demo tenants, seed/reset and the demo sign-in.
APP_MODE=DEMO

# ── Database (embedded Postgres 17 on port 54329: `npm run db:start`) ────────
# App role (RLS enforced) used by the web process and the worker.
DATABASE_URL=postgres://lumbung_app:lumbung_app@localhost:54329/lumbung
# Owner role: migrate / seed / reset scripts ONLY. Must NOT be set for a LIVE web process.
DATABASE_OWNER_URL=postgres://lumbung_owner:lumbung_owner@localhost:54329/lumbung
# Superuser: `npm run db:bootstrap` (roles + database) ONLY.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres
# Tests reuse this server when it answers, otherwise start their own instance.
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54329/postgres

# ── Application ──────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
# Operational time zone. All dates are shown with this zone and its label (WIB).
# The simulated clock itself lives in the DB (tenant_clocks; FROZEN at the seed instant
# 2026-10-26 08:00 WIB) and is advanced from the UI/API, not from an env var.
APP_TIMEZONE=Asia/Jakarta

# ── Secrets (DEMO/TEST fall back to insecure dev defaults with a warning) ────
# HMAC key for the lb_session cookie, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# AES-256-GCM key for contact addresses at rest: 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTACT_ENC_KEY=

# Private evidence/media storage directory (never public).
MEDIA_DIR=.data/media

# ── Adapters ─────────────────────────────────────────────────────────────────
# Messaging: mock | fonnte. DEMO/TEST always use the mock adapter regardless (INV10).
MESSAGING_ADAPTER=mock
# Optional; only used in LIVE with MESSAGING_ADAPTER=fonnte after activation approval.
FONNTE_TOKEN=
# Routing: fixture (reproducible demo times) | straight_line (haversine fallback).
ROUTING_ADAPTER=fixture
# P0 messaging uses the deterministic fake parser and tool path.
# gemini is reserved configuration; the live model adapter is not enabled.
LLM_ADAPTER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Worker ───────────────────────────────────────────────────────────────────
# Identifier written to outbox leases and heartbeats (defaults to a random UUID).
WORKER_ID=
# Optional tenant UUID. Defaults to the deterministic foodcycle-demo tenant in DEMO/TEST.
# LIVE requires an explicit value and its corresponding approved implementation.
WORKER_TENANT_ID=
# Job/outbox lease length in seconds (wall clock).
LEASE_SECONDS=30
