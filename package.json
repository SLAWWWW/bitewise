{
  "name": "lumbung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "tsx --conditions=react-server src/jobs/worker-main.ts",
    "db:start": "tsx scripts/db/start.ts",
    "db:bootstrap": "tsx scripts/db/bootstrap.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db/seed.ts",
    "db:reset": "tsx --conditions=react-server scripts/db/reset.ts",
    "db:setup": "npm run db:bootstrap && npm run db:migrate && npm run db:seed",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "tsx --conditions=react-server scripts/e2e.ts",
    "test:all": "vitest run && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:rehearse-backup": "tsx --conditions=react-server scripts/db/rehearse-backup.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@google/genai": "^2.16.0",
    "cobe": "2.0.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true,
    "esbuild@0.28.2": true
  }
}
